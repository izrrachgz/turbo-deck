# ASP.NET Core does not load this file automatically. Use environment variables,
# user-secrets, or the future Electron process environment.

ASPNETCORE_ENVIRONMENT=Development
TURBO_DECK_CONTROL_TOKEN=
TURBO_DECK_DATA_DIR=

# SQLite is the default. Supply both settings to select another supported engine.
Api__ConnectionStrings__Engine=SqLite
Api__ConnectionStrings__Db=

# LAN mode must use HTTPS unless insecure HTTP is deliberately enabled.
Api__Network__Mode=Loopback
Api__Network__Addresses__0=127.0.0.1
Api__Network__Port=0
Api__Network__DiscoveryEnabled=false
Api__Network__AllowInsecureHttp=false
Api__Network__CorsAllowedOrigins__0=
Api__Network__Https__Enabled=false
Api__Network__Https__CertificatePath=
Api__Network__Https__CertificatePassword=

Api__Files__RootPath=files
Api__Files__MaximumFileSizeBytes=209715200
Api__Realtime__MaximumReceiveMessageSizeBytes=65536
Api__Realtime__RequestTimeoutSeconds=30
Api__Realtime__RedisBackplaneConnectionString=
