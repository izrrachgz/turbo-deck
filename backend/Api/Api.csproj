<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TurboDeck.Backend</AssemblyName>
    <RootNamespace>Api</RootNamespace>
    <UserSecretsId>turbo-deck-backend-2c25c8fd-e735-4274-9ad7-438c75e12012</UserSecretsId>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <VisualizerSourceRoot Condition="'$(VisualizerSourceRoot)' == ''">..\..\desktop\dist\turbo-deck-visualizer\browser</VisualizerSourceRoot>
    <DeckExplorerSourceRoot Condition="'$(DeckExplorerSourceRoot)' == ''">..\..\desktop\dist\turbo-deck-explorer\browser</DeckExplorerSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DSoft.Makaretu.Dns.Multicast" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(VisualizerSourceRoot)')">
    <Content Include="$(VisualizerSourceRoot)\**\*"
             Link="wwwroot\visualizer\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(DeckExplorerSourceRoot)')">
    <Content Include="$(DeckExplorerSourceRoot)\**\*"
             Link="wwwroot\deck\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Application.Infrastructure\Application.Infrastructure.csproj" />
    <ProjectReference Include="..\Application.Migrations\Application.Migrations.csproj" />
    <PackageReference Include="CommandQ.Cqrs" />
    <PackageReference Include="CommandQ.Common" />
    <PackageReference Include="CommandQ.Localization" />
    <PackageReference Include="CommandQ.Persistence" />
    <PackageReference Include="CommandQ.Time" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="MySql.Data" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="System.Data.SQLite.Core" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="App_Data\" />
    <Folder Include="Logs\" />
  </ItemGroup>

</Project>
