{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "DataDirectory": "",
    "Network": {
      "Mode": "Loopback",
      "Addresses": [ "127.0.0.1" ],
      "Port": 0,
      "DiscoveryEnabled": false,
      "InstanceName": "Turbo Deck Backend",
      "InstanceId": "",
      "CorsAllowedOrigins": [],
      "AllowInsecureHttp": false,
      "Https": {
        "Enabled": false,
        "CertificatePath": "",
        "CertificatePassword": ""
      }
    },
    "Security": {
      "ControlToken": "",
      "LanApiKeySalt": "",
      "LanApiKeyHash": ""
    },
    "ConnectionStrings": {
      "Engine": "SqLite",
      "Db": ""
    },
    "Files": {
      "DataDirectory": "",
      "RootPath": "files",
      "MaximumFileSizeBytes": 209715200
    },
    "Realtime": {
      "MaximumReceiveMessageSizeBytes": 65536,
      "RequestTimeoutSeconds": 30,
      "RedisBackplaneConnectionString": "",
      "RedisChannelPrefix": "turbo-deck-realtime"
    }
  }
}
