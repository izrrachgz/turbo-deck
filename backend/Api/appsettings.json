{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Debug"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 16,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "standardErrorFromLevel": "Verbose",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Debug",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Api": {
    "DataDirectory": "",
    "Network": {
      "Mode": "Loopback",
      "Addresses": [ "127.0.0.1" ],
      "Port": 0,
      "DiscoveryEnabled": false,
      "InstanceName": "Turbo Deck Backend",
      "InstanceId": "",
      "CorsAllowedOrigins": [],
      "AllowInsecureHttp": false,
      "Https": {
        "Enabled": false,
        "CertificatePath": "",
        "CertificatePassword": ""
      }
    },
    "Security": {
      "ControlToken": "",
      "LanApiKeySalt": "",
      "LanApiKeyHash": ""
    },
    "ConnectionStrings": {
      "Engine": "SqLite",
      "Db": ""
    },
    "Localization": {
      "DefaultCulture": "en-US",
      "FallbackCulture": "en-US",
      "SupportedCultures": [ "en-US", "es-ES" ],
      "JsonLocalesPath": "locales",
      "ProviderOrder": [ "Json", "Resx" ]
    },
    "Files": {
      "DataDirectory": "",
      "RootPath": "files",
      "MaximumFileSizeBytes": 209715200
    },
    "Realtime": {
      "MaximumReceiveMessageSizeBytes": 65536,
      "RequestTimeoutSeconds": 30,
      "RedisBackplaneConnectionString": "",
      "RedisChannelPrefix": "turbo-deck-realtime"
    }
  }
}
