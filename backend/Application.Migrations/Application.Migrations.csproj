<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Application.Migrations</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SqlKata.Execution" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandQ.Common" />
    <PackageReference Include="CommandQ.Persistence" />
    <PackageReference Include="CommandQ.Time" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\**\*.sql" />
  </ItemGroup>

</Project>
